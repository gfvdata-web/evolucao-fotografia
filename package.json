{
  "name": "evolucao-fotografia",
  "version": "0.4.0",
  "private": true,
  "description": "Análise da qualidade de captura das fotos (Canon EOS RP) direto no navegador.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "fixtures": "node tests/fixtures/generate.mjs",
    "serve": "node scripts/serve.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run vendor && npm run fixtures && npm run test:unit && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@uswriting/exiftool": "1.0.9",
    "exifr": "7.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "jpeg-js": "0.4.4"
  }
}
